@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "LayoutDoctor";
}

<style>
    .dashboard-card {
        min-height: 250px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease-in-out;
    }

        .dashboard-card:hover {
            transform: scale(1.02);
        }

    .bg-light-blue {
        background-color: #e3f2fd; /* Light blue */
        color: #1565c0;
    }

    .bg-light-teal {
        background-color: #e0f7fa; /* Light teal */
        color: #00695c;
    }

    .dashboard-title {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .dashboard-text {
        font-size: 0.95rem;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="container mt-5">
    <h2 class="mb-4 text-center">Doctor Dashboard</h2>
    <div class="row g-4">

        <!-- View Appointments -->
        <div class="col-md-6">
            <div class="card dashboard-card bg-light-blue">
                <div class="card-header bg-transparent border-0 dashboard-title">My Appointments</div>
                <div class="card-body">
                    <div>
                        <h5 class="card-title">Appointments Overview</h5>
                        <p class="dashboard-text">Check your scheduled appointments and patient details.</p>
                    </div>
                    <a asp-action="Appointment" class="btn btn-outline-primary mt-3">View Appointments</a>
                </div>
            </div>
        </div>

        <!-- Doctor Profile -->
        <div class="col-md-6">
            <div class="card dashboard-card bg-light-teal">
                <div class="card-header bg-transparent border-0 dashboard-title">My Profile</div>
                <div class="card-body">
                    <div>
                        <h5 class="card-title">Doctor Information</h5>
                        <p class="dashboard-text">Manage your personal details and account.</p>
                    </div>
                    <a asp-action="Profile" class="btn btn-outline-info mt-3">View Profile</a>
                </div>
            </div>
        </div>

    </div>
</div>
